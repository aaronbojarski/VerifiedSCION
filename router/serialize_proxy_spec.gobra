// +gobra

package router

import (
	"github.com/gopacket/gopacket"
	
    "verification/utils/seqs"
    . "github.com/scionproto/scion/verification/utils/definitions"
    sl "verification/utils/slices"
)

pred (s *serializeProxy) NonInitMem() {
    acc(s) && 
    acc(s.data) &&
	(forall i int :: { &s.layers[i] } 0 <= i && i < len(s.layers) ==> acc(&s.layers[i]))
}

pred (s *serializeProxy) Mem() {
    acc(s) && 
    acc(s.data) && 
    s.start >= 0 &&
    s.start <= len(s.data) &&
    s.restart >= 0 &&
    s.restart <= cap(s.data) &&
	(forall i int :: { &s.layers[i] } 0 <= i && i < len(s.layers) ==> acc(&s.layers[i]))
}

ghost
pure
requires acc(s.Mem(), _)
decreases
func (s *serializeProxy) GetStart() int {
    return unfolding s.Mem() in s.start
}

ghost
pure
requires acc(s.Mem(), _)
decreases
func (s *serializeProxy) GetDataLen() int {
    return unfolding s.Mem() in len(s.data)
}

ghost
pure
requires acc(s.NonInitMem(), _)
decreases
func (s *serializeProxy) GetDataCap() int {
    return unfolding s.NonInitMem() in cap(s.data)
}

ghost
pure
requires acc(s.Mem(), _)
decreases
func (s *serializeProxy) GetDataCapMem() int {
    return unfolding s.Mem() in cap(s.data)
}

ghost
pure
requires acc(s.Mem(), _)
decreases
func (s *serializeProxy) UBuf() []byte

ghost
pure
requires acc(s.Mem(), _)
requires acc(sl.Bytes(s.UBuf(), 0, len(s.UBuf())), _)
ensures  res == seqs.ToSeqByte(s.UBuf())
decreases
func (s *serializeProxy) View() (ghost res seq[byte])

(*serializeProxy) implements gopacket.SerializeBuffer
