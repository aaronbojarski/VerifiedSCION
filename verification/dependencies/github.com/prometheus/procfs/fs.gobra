// +gobra

package procfs

// NOTE: this is simplified as it is originally in some internal package. 
// This was done to not having to provide spec for this internal package.
type internal_FS string

// FS represents the pseudo-filesystem sys, which provides an interface to
// kernel data structures.
type FS struct {
	proc   internal_FS
	isReal bool
}

// DefaultMountPoint is the common mount point of the proc filesystem.
const DefaultMountPoint = "/proc"
